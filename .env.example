# Application
APP_ENV=development
LOG_LEVEL=INFO

# Service URLs used by local development
API_PORT=8000
WEB_PORT=3000

# Database and cache values will be wired in during the Docker Compose task.
POSTGRES_DB=investment_advisor
POSTGRES_USER=investment_advisor
POSTGRES_PASSWORD=change-me-locally
REDIS_URL=redis://redis:6379/0

