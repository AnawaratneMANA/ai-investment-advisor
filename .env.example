# Application
APP_ENV=development
LOG_LEVEL=INFO
APP_DEBUG=false

# Service URLs used by local development
API_PORT=8000
WEB_PORT=3000

# Database and cache values used by local/container development.
# Leave DATABASE_URL unset to use the API's local SQLite development default.
# DATABASE_URL=postgresql://investment_advisor:change-me-locally@localhost:5432/investment_advisor
POSTGRES_DB=investment_advisor
POSTGRES_USER=investment_advisor
POSTGRES_PASSWORD=change-me-locally
REDIS_URL=redis://redis:6379/0
